# Genius API Token - 申请地址: https://genius.com/api-clients
GENIUS_ACCESS_TOKEN=your_genius_access_token_here

# NetEase EAPI 加密密钥
EAPI_KEY=your_key
# 欺骗网易 CDN Geo 检测的中国 IP（默认 118.88.88.88）
CN_PROXY_IP=118.88.88.88

# 兜底音源 — 当 NetEase 版权/VIP 拦截时，通过 Invidious API 搜索 YouTube 音频
# Invidious 是 YouTube 的开源前端代理，无需 API Key。公共实例列表见对应路由文件。
# 当前使用: inv.nadeko.net, inv.tux.pizza, invidious.privacyredirect.com

# Supabase 配置 - 申请地址: https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
