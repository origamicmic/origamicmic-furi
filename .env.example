# Genius API Token - 申请地址: https://genius.com/api-clients
GENIUS_ACCESS_TOKEN=your_genius_access_token_here

# NetEase EAPI 加密密钥
EAPI_KEY=your_key
# 欺骗网易 CDN Geo 检测的中国 IP（默认 118.88.88.88）
CN_PROXY_IP=118.88.88.88

# YouTube InnerTube API 密钥 — 提取自 YouTube Web 播放器 JS 捆包
YOUTUBE_API_KEY=your_key
# YouTube InnerTube 客户端版本 — 提取自 YouTube Web 播放器 JS 捆包
YOUTUBE_CLIENT_VERSION=2.20250423.00.00

# Supabase 配置 - 申请地址: https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
