# Genius API Token - 申请地址: https://genius.com/api-clients
GENIUS_ACCESS_TOKEN=your_genius_access_token_here

# NetEase EAPI 加密密钥
EAPI_KEY=your_key
# 欺骗网易 CDN Geo 检测的中国 IP（默认 118.88.88.88）
CN_PROXY_IP=118.88.88.88

# 兜底音源 — 当 NetEase 版权/VIP 拦截时，通过 SoundCloud API 搜索音频
# client_id 自动从 SoundCloud 主页 JS 提取，无需手动配置
本地开发时若 SoundCloud 不可达，可配 HTTP 代理（Vercel 部署无需此配置）
SC_PROXY=http://127.0.0.1:7897

# Supabase 配置 - 申请地址: https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
